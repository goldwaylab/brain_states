clear all

[test, weighted_results, maxNumClusters, minNumClusters, nsplits, nparc, basedir_, atlas, tokens, name_length, ~, ~] = setGlobalVar();
numClusters = 6;
for i = 1:size(weighted_results, 1)
    basedir = [basedir_, weighted_results{i}]; 
    masterdir = get_masterdir(test, basedir) ;
    scanlab = load([masterdir, '/analyses/transitionprobabilities/scanlab.mat']).scanlab;
    variable_names = load([masterdir, '/clusterAssignments/k',num2str(numClusters),'.mat']).clusterAssignments.(['k',num2str(numClusters)]).clusterNames  ;
    for variable_name_i = 1:size(variable_names,1)
    end
    list_of_files = load([masterdir, '/analyses/transitionprobabilities/list_of_files.mat']).list_of_files;        

    if or(contains(test, 'tables_subs'), contains(test, 'F_TEST_DATA') )
        success = create_tables(masterdir, numClusters, scanlab, list_of_files, variable_names, true);
    elseif contains(test, 'tables')
        success = create_tables(masterdir, numClusters, scanlab, list_of_files, variable_names, false);
    elseif contains(test, 'T_TEST_DATA')
        subs = cell2table(list_of_files(1,:)', 'VariableNames', {scanlab{1}});
        index = strfind(test, 'T_TEST_DATA');
        masterdir = fullfile(basedir,test(index:end));

        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{1},'DwellTime_k',num2str(numClusters),'.mat']).RunRate  ;
        subs = subs(1:size(data,1), :);
        dataTable_ket = array2table(data, 'VariableNames', strcat(scanlab{1}, variable_names));
        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{2},'DwellTime_k',num2str(numClusters),'.mat']).RunRate  ;
        dataTable_no_ket = array2table(data, 'VariableNames', strcat(scanlab{2}, variable_names));
        file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test, '_rr_results.xlsx'];
        save_stat(dataTable_ket, dataTable_no_ket, file_name, variable_names, subs, scanlab{1}, scanlab{2}, numClusters)

        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{1},'DwellTime_k',num2str(numClusters),'.mat']).DwellTimeMean  ;
        dataTable_ket = array2table(data, 'VariableNames', strcat(scanlab{1}, variable_names));
        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{2},'DwellTime_k',num2str(numClusters),'.mat']).DwellTimeMean  ;
        dataTable_no_ket = array2table(data, 'VariableNames', strcat(scanlab{2}, variable_names));
        file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test,'_dwt_results.xlsx'];
        save_stat(dataTable_ket, dataTable_no_ket, file_name, variable_names, subs, scanlab{1}, scanlab{2}, numClusters)
        
        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{1},'FractionalOccupancy_k',num2str(numClusters),'.mat']).FractionalOccupancy  ;
        dataTable_ket = array2table(data, 'VariableNames', strcat(scanlab{1}, variable_names));
        data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{2},'FractionalOccupancy_k',num2str(numClusters),'.mat']).FractionalOccupancy  ;
        dataTable_no_ket = array2table(data, 'VariableNames', strcat(scanlab{2}, variable_names));
        file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test,'_fo_results.xlsx'];
        save_stat(dataTable_ket, dataTable_no_ket, file_name, variable_names, subs, scanlab{1}, scanlab{2}, numClusters)   
    elseif contains(test, 'T_TEST_M_DATA')
        done_subs = 0;
        for pair = 0:2:size(scanlab, 1)-1
            masterdir = fullfile(basedir,'REST_PTSD_FIBRIO');
    
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+1},'DwellTime_k',num2str(numClusters),'.mat']).RunRate  ;
            files = list_of_files(pair+1,:)';
            files = files(1:size(data));
            subs = cell2table(files, 'VariableNames', {scanlab{pair+1}});
            dataTable_TP1 = array2table(data, 'VariableNames', strcat(scanlab{pair+1}, variable_names));
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+2},'DwellTime_k',num2str(numClusters),'.mat']).RunRate  ;
            dataTable_TP2 = array2table(data, 'VariableNames', strcat(scanlab{pair+2}, variable_names));
            file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test, '_', scanlab{pair+1}, '_',scanlab{pair+2}, '_rr_results.xlsx'];
            save_stat(dataTable_TP1, dataTable_TP2, file_name, variable_names, subs, scanlab{pair+1}, scanlab{pair+2}, numClusters)
    
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+1},'DwellTime_k',num2str(numClusters),'.mat']).DwellTimeMean  ;
            dataTable_TP1 = array2table(data, 'VariableNames', strcat(scanlab{pair+1}, variable_names));
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+2},'DwellTime_k',num2str(numClusters),'.mat']).DwellTimeMean  ;
            dataTable_TP2 = array2table(data, 'VariableNames', strcat(scanlab{pair+2}, variable_names));
            file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test,'_', scanlab{pair+1}, '_',scanlab{pair+2},'_dwt_results.xlsx'];
            save_stat(dataTable_TP1, dataTable_TP2, file_name, variable_names, subs, scanlab{pair+1}, scanlab{pair+2}, numClusters)
            
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+1},'FractionalOccupancy_k',num2str(numClusters),'.mat']).FractionalOccupancy  ;
            dataTable_TP1 = array2table(data, 'VariableNames', strcat(scanlab{pair+1}, variable_names));
            data = load([masterdir, '\analyses\transitionprobabilities\', scanlab{pair+2},'FractionalOccupancy_k',num2str(numClusters),'.mat']).FractionalOccupancy  ;
            dataTable_TP2 = array2table(data, 'VariableNames', strcat(scanlab{pair+2}, variable_names));
            file_name = [masterdir, '\analyses\k',num2str(numClusters),'_', test,'_', scanlab{pair+1}, '_',scanlab{pair+2},'_fo_results.xlsx'];
            save_stat(dataTable_TP1, dataTable_TP2, file_name, variable_names, subs, scanlab{pair+1}, scanlab{pair+2}, numClusters)   
            done_subs = done_subs+size(subs,1);

        end
    end    
end

function success = create_tables(basedir, numClusters, scanlab, list_of_files, variable_names, enriched)
    for ii = 1: size(variable_names,1)
        variable_names{ii} = [num2str(ii), '_', variable_names{ii} ];
    end

    all_tables_rr = [];
    all_tables_dwt = [];
    all_tables_fo = [];

    for group_i = 1:size(scanlab,1)
        sub_dataTable = cell2table(list_of_files(group_i,:)', 'VariableNames', {scanlab{group_i}});
        data_size = size(sub_dataTable,1);

        data = load([basedir, '\analyses\transitionprobabilities\', scanlab{group_i},'DwellTime_k',num2str(numClusters),'.mat']).RunRate  ;
        dataTable_rr = create_table(data, data_size, scanlab{group_i}, variable_names);

        data = load([basedir, '\analyses\transitionprobabilities\', scanlab{group_i},'DwellTime_k',num2str(numClusters),'.mat']).DwellTimeMean  ;
        dataTable_dwt = create_table(data, data_size, scanlab{group_i}, variable_names);

        data = load([basedir, '\analyses\transitionprobabilities\', scanlab{group_i},'FractionalOccupancy_k',num2str(numClusters),'.mat']).FractionalOccupancy  ;
        dataTable_fo = create_table(data, data_size, scanlab{group_i}, variable_names);

        if enriched
            all_tables_rr = [all_tables_rr, sub_dataTable, dataTable_rr];
            all_tables_dwt = [all_tables_dwt, sub_dataTable, dataTable_dwt];
            all_tables_fo = [all_tables_fo, sub_dataTable, dataTable_fo];
        else
            all_tables_rr = [all_tables_rr, dataTable_rr];
            all_tables_dwt = [all_tables_dwt, dataTable_dwt];
            all_tables_fo = [all_tables_fo, dataTable_fo];
        end

    end
    file_name = [basedir, '\analyses\rr_results.xlsx'];
    writetable(all_tables_rr, file_name, 'WriteVariableNames', true);

    file_name = [basedir, '\analyses\dwt_results.xlsx'];
    writetable(all_tables_dwt, file_name, 'WriteVariableNames', true);

    file_name = [basedir, '\analyses\fo_results.xlsx'];
    writetable(all_tables_fo, file_name, 'WriteVariableNames', true);

    success = true;
end

function success = save_stat(dataTable_ket, dataTable_no_ket, file_name, variable_names, subs, str1, str2, numClusters)
    emptyArray = cell(size(subs,1), numClusters+1);
    variable_names_ = ['Param';variable_names];
    stat = cell2table(emptyArray, 'VariableNames', variable_names_);
    stat{1,1}={'p-value '};
    stat{2,1}={[str1,'average']};
    stat{3,1}={[str2, 'average']};
    for i = 1:size(variable_names,1)
         p = [my_ttest(dataTable_ket{:, i}, dataTable_no_ket{:, i}, variable_names(i,1))];
         stat{1,i+1} = {p};
         stat{2,i+1} = {mean(dataTable_ket{:, i})};
         stat{3,i+1} = {mean(dataTable_no_ket{:, i})};
    end
    
    writetable([subs, dataTable_ket, dataTable_no_ket, stat], file_name, 'WriteVariableNames', true);
    success = true;
end
function [p] = my_ttest(group1, group2, title)

    [h, p, ci, stats] = ttest(group1, group2);
    % Display the results
    disp(title);
    fprintf('Paired t-test results:\n');
    fprintf('p-value: %f\n', p);
    fprintf('t-statistic: %f\n', stats.tstat);
    fprintf('Degrees of freedom: %d\n', stats.df);

end

function dataTable = create_table(data, targetRows, prefix, variable_names)
    numColumns = size(data, 2);
    expandedArray = nan(targetRows, numColumns);
    expandedArray(1:size(data, 1), :) = data;
    dataTable = array2table(expandedArray, 'VariableNames', strcat(prefix, variable_names));
end